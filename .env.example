# GeoRSI Lab - 环境变量模板
# 复制本文件为 .env 并填入真实值:  copy .env.example .env  (Windows) / cp .env.example .env (Linux)
# docker compose 会自动加载 .env

# === 必需: 网关 API Key (三选一或多选，取决于 config.json 选择的模型) ===
# Zen 网关 (hy3 / mimo-v2.5 / muse-spark-1.2)
RSILAB_API_KEY=

# OpenRouter (z-ai/glm-5.3-flash / minimax-m3)
RSILAB_OR_KEY=

# 校园本地 dsv4f (若启用)
RSILAB_LOCAL_API_KEY=

# 临时 emooo 网关 mimo-v2.5-pro (环境变量专用，不写入文件)
RSILAB_EMOOO_API_KEY=

# 研究长程网关 Luna (research-competition-luna.json)
GEORSI_RESEARCH_API_KEY=
GEORSI_HTTP_PROXY=
GEORSI_HTTPS_PROXY=
GEILIAPI_API_KEY=

# LLM Judge (gab/gbx 私有评测)
RSILAB_JUDGE_BASE=
RSILAB_JUDGE_KEY=
RSILAB_JUDGE_MODEL=

# === 可选: 代理 (若模型 route=proxy，如 muse-spark-1.2) ===
# HTTPS_PROXY=http://host.docker.internal:7897
# HTTP_PROXY=http://host.docker.internal:7897
# NO_PROXY=localhost,127.0.0.1

# === 可选: 运行时 ===
TZ=Asia/Shanghai
# RSILAB_REQUEST_MAX_TOKENS=16384
# RSILAB_KB_INCLUDE_PROBATION=0
