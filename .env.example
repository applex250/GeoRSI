# GeoRSI Lab - 环境变量模板
# 复制本文件为 .env 并填入真实值:  copy .env.example .env  (Windows) / cp .env.example .env (Linux)
# docker compose 会自动加载 .env

# === 必需: 网关 API Key (三选一或多选，取决于 config.json 选择的模型) ===
# Zen 网关 (hy3 / mimo-v2.5 / muse-spark-1.2)
RSILAB_API_KEY=

# OpenRouter (z-ai/glm-5.3-flash / minimax-m3)
RSILAB_OR_KEY=

# 校园本地 dsv4f (若启用)
RSILAB_LOCAL_API_KEY=

# 临时 emooo 网关 mimo-v2.5-pro (环境变量专用，不写入文件)
RSILAB_EMOOO_API_KEY=

# 研究长程网关 Luna (research-competition-luna.json)
GEORSI_RESEARCH_API_KEY=
GEORSI_HTTP_PROXY=
GEORSI_HTTPS_PROXY=
GEORSI_WORKSPACE_ROUNDS=3
GEORSI_WORKSPACE_MODEL_CALLS=60
GEILIAPI_API_KEY=

# === 工作台（研究引擎开发档） ===
# Crossref polite pool 联系邮箱（文献检索工具带上它可获得独立、更快的限流通道）
GEORSI_CROSSREF_MAILTO=
# 回退到第二阶段自包含 agent：GEORSI_WORKSPACE_ENGINE=legacy（默认走研究引擎）
# GEORSI_WORKSPACE_ENGINE=
# 经验库目录（默认 knowledge/experience；自测会重定向到临时目录）
# GEORSI_EXPERIENCE_ROOT=

# === HTTP API (src/api/server.ts) ===
# 共享令牌：设置后所有 /api 请求须带 Authorization: Bearer <token> 或 X-GeoRSI-Token。
# 前端代理 (web/) 从同名变量读取并在服务端附加，浏览器不会看到它。
# 生成示例: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
GEORSI_API_TOKEN=
# 监听地址：本机直跑默认 127.0.0.1；docker-compose 内已固定为 0.0.0.0（端口只发布到宿主 loopback）。
# GEORSI_API_HOST=127.0.0.1
# GEORSI_API_PORT=8787
# 同时运行的任务上限（每个任务 = 一个 Node + Python + 计费模型的子进程）
GEORSI_API_MAX_CONCURRENT=2
# 允许跨域调用的浏览器来源；不设则不发 CORS 头（前端走同源代理，不需要）。
# GEORSI_API_ALLOWED_ORIGIN=http://localhost:3000

# LLM Judge (gab/gbx 私有评测)
RSILAB_JUDGE_BASE=
RSILAB_JUDGE_KEY=
RSILAB_JUDGE_MODEL=

# === 可选: 代理 (若模型 route=proxy，如 muse-spark-1.2) ===
# HTTPS_PROXY=http://host.docker.internal:7897
# HTTP_PROXY=http://host.docker.internal:7897
# NO_PROXY=localhost,127.0.0.1

# === 可选: 运行时 ===
TZ=Asia/Shanghai
# RSILAB_REQUEST_MAX_TOKENS=16384
# RSILAB_KB_INCLUDE_PROBATION=0
