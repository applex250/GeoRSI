flowchart LR
    operator["Operator / Researcher"]

    subgraph control["Control Plane"]
        cli["CLI / TUI<br/>src/run.ts + src/tui"]
        extension["Pi Extension<br/>extensions/georsi.ts"]
        controller["Pause / Resume / Stop<br/>RunController"]
    end

    subgraph core["Core Research Engine"]
        orchestrator["RSI Orchestrator<br/>src/rsi.ts"]
        evolution["Propose -> Critique -> Verify<br/>outer model"]
        solver["Inner Solver<br/>one isolated episode"]
        episode["Prompt -> Tools -> Submit<br/>agent loop"]
    end

    subgraph boundary["Evaluation Boundary"]
        publicEval["Public Eval<br/>visible score feedback"]
        privateEval["Private Eval<br/>selection fitness"]
        guard["Guard + Manifest<br/>anti-cheat and integrity"]
    end

    subgraph runtime["Runtime and Assets"]
        modelRuntime["Provider + Pi Harness<br/>routing, profiles, timeouts, tokens"]
        problemRegistry["Problem Registry<br/>statements, data, eval.py"]
        learning["Learning Assets<br/>scaffold, knowledge, memory, optional RAG"]
        artifacts["Run Artifacts<br/>state, journal, variants, reports"]
    end

    providers["Model APIs / Local Server"]
    python["Python / GIS Tools"]

    operator --> cli
    operator --> extension
    extension --> controller
    cli --> orchestrator
    controller --> orchestrator

    orchestrator --> evolution
    evolution --> orchestrator
    orchestrator --> solver
    solver --> episode
    episode --> solver
    solver --> publicEval
    publicEval --> episode
    solver --> privateEval
    solver --> guard

    orchestrator --> modelRuntime
    evolution --> modelRuntime
    solver --> modelRuntime
    modelRuntime --> providers
    episode --> python

    solver --> problemRegistry
    publicEval --> problemRegistry
    privateEval --> problemRegistry
    solver --> learning
    orchestrator --> learning
    orchestrator --> artifacts
    solver --> artifacts

