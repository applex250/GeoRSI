{
	"name": "georsi",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Self-evolving geoscience research RSI system on the pi agent harness",
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"selftest": "tsx src/run.ts selftest",
		"smoke": "tsx src/run.ts smoke",
		"exam": "tsx src/run.ts exam",
		"rsi": "tsx src/run.ts rsi",
		"resume": "tsx src/run.ts rsi --resume",
		"tui": "tsx src/run.ts tui",
		"tuitest": "tsx src/tui/headless-check.ts && tsx src/tui/altscreen-check.ts && tsx config/think-check.ts && tsx config/control-check.ts",
		"agent": "node node_modules/@earendil-works/pi-coding-agent/dist/cli.js -e extensions/georsi.ts",
		"extcheck": "tsx src/tui/ext-check.ts"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "0.84.2",
		"@earendil-works/pi-ai": "0.84.2",
		"@earendil-works/pi-coding-agent": "0.84.2",
		"@earendil-works/pi-tui": "0.84.2",
		"chalk": "6.0.0",
		"typebox": "1.1.38",
		"undici": "8.9.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"tsx": "^4.19.0",
		"typescript": "^5.6.0"
	}
}
